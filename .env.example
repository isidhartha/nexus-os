OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Free local LLM alternative (no API key required)
# Set LLM_PROVIDER=ollama to use local Llama instead of OpenAI
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
WAKE_WORD=nexus
VOICE_LANGUAGE=en-US
DATABASE_URL=postgresql://nexus:password@postgres:5432/nexusdb
REDIS_URL=redis://redis:6379
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MEMORY_DB_PATH=./data/memory.db
ALLOWED_COMMANDS=ls,pwd,echo,python,node,npm
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WHISPER_MODEL=base
TTS_RATE=175
TTS_VOLUME=1.0
MAX_MEMORY_ENTRIES=1000
WORKFLOW_TIMEOUT=300
BROWSER_HEADLESS=true
SANDBOX_TIMEOUT=30
PLUGIN_DIR=./plugins
SECRET_KEY=change-me-in-production
